<view class="complaint-container data-v-ed7d3e2e"><view class="complaint-header data-v-ed7d3e2e"><text class="title data-v-ed7d3e2e">提交投诉</text><text class="subtitle data-v-ed7d3e2e">{{"请补充投诉“"+query.title+"”的具体依据"}}</text></view><view class="complaint-form data-v-ed7d3e2e"><view class="form-item data-v-ed7d3e2e"><text class="item-label data-v-ed7d3e2e">投诉标题<text class="required data-v-ed7d3e2e">*</text></text><input style="background-color:#F8F9FA;padding:30rpx;font-size:28rpx;" placeholder="请简述一下您遇到的问题" data-event-opts="{{[['input',[['__set_model',['$0','title','$event',[]],['formData']]]]]}}" value="{{formData.title}}" bindinput="__e" class="data-v-ed7d3e2e"/></view><view class="form-item data-v-ed7d3e2e"><text class="item-label data-v-ed7d3e2e">投诉描述<text class="required data-v-ed7d3e2e">*</text></text><textarea class="content-input data-v-ed7d3e2e" placeholder="请详细描述遇到的问题（建议包含时间、地点、具体经过）" maxlength="500" data-event-opts="{{[['input',[['__set_model',['$0','content','$event',[]],['formData']]]]]}}" value="{{formData.content}}" bindinput="__e"></textarea><view class="word-counter data-v-ed7d3e2e">{{''+$root.g0+'/500'}}</view></view><view class="form-item data-v-ed7d3e2e"><text class="item-label data-v-ed7d3e2e">上传凭证</text><view class="upload-area data-v-ed7d3e2e"><view data-event-opts="{{[['tap',[['selectImage',['$event']]]]]}}" class="upload-card data-v-ed7d3e2e" bindtap="__e"><uni-icons vue-id="4c71dd00-1" type="plusempty" size="36" color="#7A9D7E" class="data-v-ed7d3e2e" bind:__l="__l"></uni-icons><text class="upload-tip data-v-ed7d3e2e">请选择上传图片</text><text class="upload-subtip data-v-ed7d3e2e">最多6张图片</text></view><block wx:if="{{$root.g1>0}}"><view class="preview-grid data-v-ed7d3e2e"><block wx:for="{{fileList}}" wx:for-item="file" wx:for-index="index" wx:key="index"><view class="preview-item data-v-ed7d3e2e"><image class="preview-image data-v-ed7d3e2e" src="{{file.data.url}}" mode="aspectFill"></image><uni-icons class="delete-icon data-v-ed7d3e2e" vue-id="{{'4c71dd00-2-'+index}}" type="close" size="18" data-event-opts="{{[['^click',[['removeFile',[index]]]]]}}" bind:click="__e" bind:__l="__l"></uni-icons></view></block></view></block></view></view><view class="form-item data-v-ed7d3e2e"><text class="item-label data-v-ed7d3e2e">联系电话<text class="required data-v-ed7d3e2e">*</text></text><view class="phone-input data-v-ed7d3e2e"><uni-icons vue-id="4c71dd00-3" type="phone" size="20" color="#7A9D7E" class="data-v-ed7d3e2e" bind:__l="__l"></uni-icons><input type="number" placeholder="请输入您的手机号码" maxlength="11" data-event-opts="{{[['input',[['__set_model',['$0','phone','$event',[]],['formData']]]]]}}" value="{{formData.phone}}" bindinput="__e" class="data-v-ed7d3e2e"/></view></view></view><view class="submit-area data-v-ed7d3e2e"><button data-event-opts="{{[['tap',[['handleSubmit',['$event']]]]]}}" class="submit-btn data-v-ed7d3e2e" bindtap="__e"> 立即提交 </button><text class="agreement-tip data-v-ed7d3e2e">提交之后工作人员将在两个小时之后联系您，请保持通话正常</text></view></view>